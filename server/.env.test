# Test environment — copy this and fill in real values for integration tests
NODE_ENV=test
PORT=5001

# Use a SEPARATE test database — never point at production!
DATABASE_URL=postgresql://user:password@localhost:5432/cookers_delight_test

# Use a fixed, known secret so tokens generated in tests are valid
JWT_SECRET=test-jwt-secret-key-for-testing-only-do-not-use-in-production

# Optional — set if integration tests need Google OAuth
# GOOGLE_CLIENT_ID=

# Not needed for unit/functional tests (Prisma is mocked)
# Only required for integration tests that hit a real DB
